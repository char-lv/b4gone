+"use client";
+
+import { useState } from "react";
+import { NewPurchaseForm } from "@/components/NewPurchaseForm";
+import type { NewPurchase } from "@/lib/purchase";
+
+// Saving is not implemented yet, so this only echoes the most recent submission back.
+export function NewPurchaseSection() {
+  const [lastSubmitted, setLastSubmitted] = useState<NewPurchase | null>(null);
+
+  return (
+    <>
+      <NewPurchaseForm onSubmit={setLastSubmitted} />
+      {lastSubmitted && (
+        <section role="status" className="rounded-md border border-accent/40 bg-white p-4">
+          <h2 className="font-semibold">Received &ldquo;{lastSubmitted.itemName}&rdquo;</h2>
+          <p className="text-sm">Saving purchases isn&rsquo;t available yet, so this entry is not stored.</p>
+        </section>
+      )}
+    </>
+  );
+}
