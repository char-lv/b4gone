+"use client";
+
+import { useId, useState, type FormEvent } from "react";
+import {
+  ITEM_NAME_MAX_LENGTH,
+  validateNewPurchase,
+  type NewPurchase,
+  type NewPurchaseErrors,
+  type NewPurchaseInput,
+} from "@/lib/purchase";
+
+const EMPTY_INPUT: NewPurchaseInput = {
+  itemName: "",
+  purchaseDate: "",
+  price: "",
+  returnDeadline: "",
+  warrantyExpiration: "",
+};
+
+type FieldConfig = {
+  name: keyof NewPurchaseInput;
+  label: string;
+  type: "text" | "date";
+  required: boolean;
+  hint?: string;
+};
+
+const FIELDS: FieldConfig[] = [
+  { name: "itemName", label: "Item name", type: "text", required: true },
+  { name: "purchaseDate", label: "Purchase date", type: "date", required: true },
+  { name: "price", label: "Price (USD)", type: "text", required: false, hint: "For example, 19.99" },
+  { name: "returnDeadline", label: "Return deadline", type: "date", required: false },
+  { name: "warrantyExpiration", label: "Warranty expiration date", type: "date", required: false },
+];
+
+export type NewPurchaseFormProps = {
+  /** Called with the validated purchase. The form clears itself after it returns. */
+  onSubmit: (purchase: NewPurchase) => void;
+};
+
+export function NewPurchaseForm({ onSubmit }: NewPurchaseFormProps) {
+  const idPrefix = useId();
+  const [input, setInput] = useState<NewPurchaseInput>(EMPTY_INPUT);
+  const [errors, setErrors] = useState<NewPurchaseErrors>({});
+
+  function handleSubmit(event: FormEvent<HTMLFormElement>) {
+    event.preventDefault();
+    const result = validateNewPurchase(input);
+    if (!result.ok) {
+      setErrors(result.errors);
+      const firstInvalid = FIELDS.find((field) => result.errors[field.name]);
+      if (firstInvalid) document.getElementById(`${idPrefix}-${firstInvalid.name}`)?.focus();
+      return;
+    }
+    setErrors({});
+    onSubmit(result.value);
+    setInput(EMPTY_INPUT);
+  }
+
+  return (
+    <form noValidate onSubmit={handleSubmit} aria-label="New purchase" className="flex flex-col gap-5">
+      {FIELDS.map((field) => {
+        const id = `${idPrefix}-${field.name}`;
+        const error = errors[field.name];
+        const describedBy =
+          [field.hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(" ") ||
+          undefined;
+        return (
+          <div key={field.name} className="flex flex-col gap-1">
+            <label htmlFor={id} className="font-medium">
+              {field.label}
+              {field.required ? (
+                <span aria-hidden="true" className="text-red-700">
+                  {" "}
+                  *
+                </span>
+              ) : (
+                <span className="font-normal text-ink/70"> (optional)</span>
+              )}
+            </label>
+            {field.hint && (
+              <p id={`${id}-hint`} className="text-sm text-ink/70">
+                {field.hint}
+              </p>
+            )}
+            <input
+              id={id}
+              name={field.name}
+              type={field.type}
+              inputMode={field.name === "price" ? "decimal" : undefined}
+              maxLength={field.name === "itemName" ? ITEM_NAME_MAX_LENGTH : undefined}
+              required={field.required}
+              aria-invalid={error ? true : undefined}
+              aria-describedby={describedBy}
+              value={input[field.name]}
+              onChange={(event) => setInput({ ...input, [field.name]: event.target.value })}
+              className="rounded-md border border-ink/30 bg-white px-3 py-2 focus:outline-2 focus:outline-accent aria-invalid:border-red-700"
+            />
+            {error && (
+              <p id={`${id}-error`} className="text-sm text-red-700">
+                {error}
+              </p>
+            )}
+          </div>
+        );
+      })}
+      <button
+        type="submit"
+        className="self-start rounded-md bg-accent px-4 py-2 font-medium text-white hover:opacity-90 focus:outline-2 focus:outline-offset-2 focus:outline-accent"
+      >
+        Add purchase
+      </button>
+    </form>
+  );
+}
