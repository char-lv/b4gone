+++ b/src/lib/purchase.ts
@@ -0,0 +1,110 @@
+// Validation for the "new purchase" form. Kept free of React so it can be reused by the API
+// layer once persistence exists.
+
+export type NewPurchase = {
+  itemName: string;
+  /** Calendar date in YYYY-MM-DD form. */
+  purchaseDate: string;
+  /** Price in US cents, so amounts never pass through floating point. */
+  priceCents: number | null;
+  returnDeadline: string | null;
+  warrantyExpiration: string | null;
+};
+
+/** Raw string values as they come out of the form inputs. */
+export type NewPurchaseInput = {
+  itemName: string;
+  purchaseDate: string;
+  price: string;
+  returnDeadline: string;
+  warrantyExpiration: string;
+};
+
+export type NewPurchaseErrors = Partial<Record<keyof NewPurchaseInput, string>>;
+
+export type ValidationResult =
+  | { ok: true; value: NewPurchase }
+  | { ok: false; errors: NewPurchaseErrors };
+
+export const ITEM_NAME_MAX_LENGTH = 200;
+// Upper bound keeps cents comfortably inside Number.MAX_SAFE_INTEGER.
+export const PRICE_MAX_CENTS = 100_000_000_00;
+
+const ISO_DATE = /^(\d{4})-(\d{2})-(\d{2})$/;
+const PRICE = /^(\d+)(?:\.(\d{1,2}))?$/;
+
+/** True when the string is YYYY-MM-DD and names a real calendar date. */
+export function isValidIsoDate(value: string): boolean {
+  const match = ISO_DATE.exec(value);
+  if (!match) return false;
+  const [year, month, day] = match.slice(1).map(Number);
+  const date = new Date(Date.UTC(year, month - 1, day));
+  return (
+    date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day
+  );
+}
+
+/**
+ * Parses a USD amount such as "19.99", "$1,250" or "0.5" into cents. Returns null when the
+ * text is not a valid non-negative amount with at most two decimal places.
+ */
+export function parsePriceToCents(value: string): number | null {
+  const normalized = value.trim().replace(/^\$/, "").replace(/,/g, "");
+  const match = PRICE.exec(normalized);
+  if (!match) return null;
+  const dollars = Number(match[1]);
+  const cents = Number((match[2] ?? "").padEnd(2, "0"));
+  return dollars * 100 + cents;
+}
+
+export function validateNewPurchase(input: NewPurchaseInput): ValidationResult {
+  const errors: NewPurchaseErrors = {};
+
+  const itemName = input.itemName.trim();
+  if (!itemName) {
+    errors.itemName = "Enter the item name.";
+  } else if (itemName.length > ITEM_NAME_MAX_LENGTH) {
+    errors.itemName = `Item name must be ${ITEM_NAME_MAX_LENGTH} characters or fewer.`;
+  }
+
+  const purchaseDate = input.purchaseDate.trim();
+  if (!purchaseDate) {
+    errors.purchaseDate = "Enter the purchase date.";
+  } else if (!isValidIsoDate(purchaseDate)) {
+    errors.purchaseDate = "Enter a valid purchase date.";
+  }
+
+  let priceCents: number | null = null;
+  const price = input.price.trim();
+  if (price) {
+    priceCents = parsePriceToCents(price);
+    if (priceCents === null) {
+      errors.price = "Enter a price in dollars, such as 19.99.";
+    } else if (priceCents > PRICE_MAX_CENTS) {
+      errors.price = "Price is too large.";
+    }
+  }
+
+  const optionalDate = (
+    field: "returnDeadline" | "warrantyExpiration",
+    label: string,
+  ): string | null => {
+    const value = input[field].trim();
+    if (!value) return null;
+    if (!isValidIsoDate(value)) {
+      errors[field] = `Enter a valid ${label}.`;
+    } else if (!errors.purchaseDate && value < purchaseDate) {
+      // YYYY-MM-DD strings sort chronologically, so string comparison is safe here.
+      errors[field] = `The ${label} can't be before the purchase date.`;
+    }
+    return value;
+  };
+  const returnDeadline = optionalDate("returnDeadline", "return deadline");
+  const warrantyExpiration = optionalDate("warrantyExpiration", "warranty expiration date");
+
+  if (Object.keys(errors).length > 0) return { ok: false, errors };
+  return {
+    ok: true,
+    value: { itemName, purchaseDate, priceCents, returnDeadline, warrantyExpiration },
+  };
+}
