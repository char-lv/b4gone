+import {
+  isValidIsoDate,
+  ITEM_NAME_MAX_LENGTH,
+  parsePriceToCents,
+  validateNewPurchase,
+  type NewPurchaseInput,
+} from "./purchase";
+
+const valid: NewPurchaseInput = {
+  itemName: "Headphones",
+  purchaseDate: "2026-10-01",
+  price: "",
+  returnDeadline: "",
+  warrantyExpiration: "",
+};
+
+describe("isValidIsoDate", () => {
+  it.each(["2026-10-01", "2024-02-29", "1999-12-31"])("accepts %s", (value) => {
+    expect(isValidIsoDate(value)).toBe(true);
+  });
+
+  it.each(["", "2026-10-1", "10/01/2026", "2026-13-01", "2026-02-30", "2025-02-29", "2026-10-01x"])(
+    "rejects %j",
+    (value) => {
+      expect(isValidIsoDate(value)).toBe(false);
+    },
+  );
+});
+
+describe("parsePriceToCents", () => {
+  it.each([
+    ["19.99", 1999],
+    ["0", 0],
+    ["0.5", 50],
+    ["12", 1200],
+    ["$1,250.00", 125000],
+    [" 3.10 ", 310],
+  ])("parses %j as %i cents", (value, cents) => {
+    expect(parsePriceToCents(value)).toBe(cents);
+  });
+
+  it.each(["", "abc", "-5", "1.999", "1.", ".50", "1e3", "12.3.4"])("rejects %j", (value) => {
+    expect(parsePriceToCents(value)).toBeNull();
+  });
+});
+
+describe("validateNewPurchase", () => {
+  it("returns only the required fields when optional ones are blank", () => {
+    expect(validateNewPurchase(valid)).toEqual({
+      ok: true,
+      value: {
+        itemName: "Headphones",
+        purchaseDate: "2026-10-01",
+        priceCents: null,
+        returnDeadline: null,
+        warrantyExpiration: null,
+      },
+    });
+  });
+
+  it("trims values and includes all optional fields", () => {
+    const result = validateNewPurchase({
+      itemName: "  Headphones  ",
+      purchaseDate: "2026-10-01",
+      price: "149.50",
+      returnDeadline: "2026-10-31",
+      warrantyExpiration: "2027-10-01",
+    });
+
+    expect(result).toEqual({
+      ok: true,
+      value: {
+        itemName: "Headphones",
+        purchaseDate: "2026-10-01",
+        priceCents: 14950,
+        returnDeadline: "2026-10-31",
+        warrantyExpiration: "2027-10-01",
+      },
+    });
+  });
+
+  it("allows deadlines on the purchase date itself", () => {
+    const result = validateNewPurchase({
+      ...valid,
+      returnDeadline: valid.purchaseDate,
+      warrantyExpiration: valid.purchaseDate,
+    });
+    expect(result.ok).toBe(true);
+  });
+
+  it("requires item name and purchase date", () => {
+    expect(validateNewPurchase({ ...valid, itemName: "   ", purchaseDate: "" })).toEqual({
+      ok: false,
+      errors: { itemName: "Enter the item name.", purchaseDate: "Enter the purchase date." },
+    });
+  });
+
+  it("rejects an item name that is too long", () => {
+    const result = validateNewPurchase({ ...valid, itemName: "x".repeat(ITEM_NAME_MAX_LENGTH + 1) });
+    expect(result).toMatchObject({ ok: false, errors: { itemName: expect.stringMatching(/200/) } });
+  });
+
+  it("rejects malformed dates and prices", () => {
+    expect(
+      validateNewPurchase({
+        ...valid,
+        purchaseDate: "2026-02-30",
+        price: "ten dollars",
+        returnDeadline: "soon",
+        warrantyExpiration: "2027-13-01",
+      }),
+    ).toEqual({
+      ok: false,
+      errors: {
+        purchaseDate: "Enter a valid purchase date.",
+        price: "Enter a price in dollars, such as 19.99.",
+        returnDeadline: "Enter a valid return deadline.",
+        warrantyExpiration: "Enter a valid warranty expiration date.",
+      },
+    });
+  });
+
+  it("rejects a price above the maximum", () => {
+    expect(validateNewPurchase({ ...valid, price: "100000000.01" })).toEqual({
+      ok: false,
+      errors: { price: "Price is too large." },
+    });
+  });
+
+  it("rejects deadlines before the purchase date", () => {
+    expect(
+      validateNewPurchase({ ...valid, returnDeadline: "2026-09-30", warrantyExpiration: "2026-01-01" }),
+    ).toEqual({
+      ok: false,
+      errors: {
+        returnDeadline: "The return deadline can't be before the purchase date.",
+        warrantyExpiration: "The warranty expiration date can't be before the purchase date.",
+      },
+    });
+  });
+
+  it("skips the ordering check when the purchase date itself is invalid", () => {
+    expect(validateNewPurchase({ ...valid, purchaseDate: "", returnDeadline: "2026-09-30" })).toEqual({
+      ok: false,
+      errors: { purchaseDate: "Enter the purchase date." },
+    });
+  });
+});
