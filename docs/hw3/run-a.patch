+import { fireEvent, render, screen } from "@testing-library/react";
+import { NewPurchaseForm } from "./NewPurchaseForm";
+
+function fill(label: RegExp, value: string) {
+  fireEvent.change(screen.getByLabelText(label), { target: { value } });
+}
+
+function submit() {
+  fireEvent.click(screen.getByRole("button", { name: "Add purchase" }));
+}
+
+describe("NewPurchaseForm", () => {
+  it("renders labelled inputs for every field", () => {
+    render(<NewPurchaseForm onSubmit={vi.fn()} />);
+
+    expect(screen.getByLabelText(/item name/i)).toHaveAttribute("type", "text");
+    expect(screen.getByLabelText(/purchase date/i)).toHaveAttribute("type", "date");
+    expect(screen.getByLabelText(/price \(usd\)/i)).toHaveAttribute("inputmode", "decimal");
+    expect(screen.getByLabelText(/return deadline/i)).toHaveAttribute("type", "date");
+    expect(screen.getByLabelText(/warranty expiration/i)).toHaveAttribute("type", "date");
+    expect(screen.getByLabelText(/item name/i)).toBeRequired();
+    expect(screen.getByLabelText(/return deadline/i)).not.toBeRequired();
+  });
+
+  it("passes the entered purchase to onSubmit and clears the form", () => {
+    const onSubmit = vi.fn();
+    render(<NewPurchaseForm onSubmit={onSubmit} />);
+
+    fill(/item name/i, "Stand mixer");
+    fill(/purchase date/i, "2026-10-20");
+    fill(/price/i, "$349.99");
+    fill(/return deadline/i, "2026-11-19");
+    fill(/warranty expiration/i, "2027-10-20");
+    submit();
+
+    expect(onSubmit).toHaveBeenCalledTimes(1);
+    expect(onSubmit).toHaveBeenCalledWith({
+      itemName: "Stand mixer",
+      purchaseDate: "2026-10-20",
+      priceCents: 34999,
+      returnDeadline: "2026-11-19",
+      warrantyExpiration: "2027-10-20",
+    });
+    expect(screen.getByLabelText(/item name/i)).toHaveValue("");
+    expect(screen.getByLabelText(/price/i)).toHaveValue("");
+  });
+
+  it("submits with only the required fields", () => {
+    const onSubmit = vi.fn();
+    render(<NewPurchaseForm onSubmit={onSubmit} />);
+
+    fill(/item name/i, "Socks");
+    fill(/purchase date/i, "2026-10-20");
+    submit();
+
+    expect(onSubmit).toHaveBeenCalledWith({
+      itemName: "Socks",
+      purchaseDate: "2026-10-20",
+      priceCents: null,
+      returnDeadline: null,
+      warrantyExpiration: null,
+    });
+  });
+
+  it("shows errors, focuses the first invalid field, and does not call onSubmit", () => {
+    const onSubmit = vi.fn();
+    render(<NewPurchaseForm onSubmit={onSubmit} />);
+
+    fill(/price/i, "abc");
+    submit();
+
+    expect(onSubmit).not.toHaveBeenCalled();
+    const itemName = screen.getByLabelText(/item name/i);
+    expect(itemName).toHaveFocus();
+    expect(itemName).toHaveAttribute("aria-invalid", "true");
+    expect(itemName).toHaveAccessibleDescription("Enter the item name.");
+    expect(screen.getByLabelText(/purchase date/i)).toHaveAccessibleDescription(
+      "Enter the purchase date.",
+    );
+    expect(screen.getByLabelText(/price/i)).toHaveAccessibleDescription(
+      "For example, 19.99 Enter a price in dollars, such as 19.99.",
+    );
+    // Entered values are kept so the user can correct them.
+    expect(screen.getByLabelText(/price/i)).toHaveValue("abc");
+  });
+
+  it("clears errors once the input is corrected and resubmitted", () => {
+    const onSubmit = vi.fn();
+    render(<NewPurchaseForm onSubmit={onSubmit} />);
+
+    submit();
+    expect(screen.getByText("Enter the item name.")).toBeInTheDocument();
+
+    fill(/item name/i, "Lamp");
+    fill(/purchase date/i, "2026-10-20");
+    submit();
+
+    expect(onSubmit).toHaveBeenCalledTimes(1);
+    expect(screen.queryByText("Enter the item name.")).not.toBeInTheDocument();
+    expect(screen.getByLabelText(/item name/i)).not.toHaveAttribute("aria-invalid");
+  });
+});
