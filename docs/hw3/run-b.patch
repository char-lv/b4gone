+import { type ItemDraft, validateItemDraft } from "./item-schema";
+
+const today = "2026-10-23";
+
+function draft(overrides: Partial<ItemDraft> = {}): ItemDraft {
+  return {
+    name: "Wool coat",
+    purchaseDate: "2026-10-09",
+    price: "",
+    returnDeadline: "",
+    warrantyExpiration: "",
+    ...overrides,
+  };
+}
+
+function errorsFor(overrides: Partial<ItemDraft>) {
+  const result = validateItemDraft(draft(overrides), today);
+  if (result.success) throw new Error("Expected validation to fail");
+  return result.fieldErrors;
+}
+
+describe("validateItemDraft", () => {
+  it("returns a trimmed item with null optional fields", () => {
+    expect(validateItemDraft(draft({ name: "  Wool coat  " }), today)).toEqual({
+      success: true,
+      data: {
+        name: "Wool coat",
+        purchaseDate: "2026-10-09",
+        priceCents: null,
+        returnDeadline: null,
+        warrantyExpiration: null,
+      },
+    });
+  });
+
+  it("keeps zero price distinct from a blank price", () => {
+    const result = validateItemDraft(draft({ price: "0" }), today);
+    expect(result).toMatchObject({ success: true, data: { priceCents: 0 } });
+  });
+
+  it("converts price to integer cents and keeps optional dates", () => {
+    const result = validateItemDraft(
+      draft({ price: "189.50", returnDeadline: "2026-11-08", warrantyExpiration: "2027-10-09" }),
+      today,
+    );
+    expect(result).toMatchObject({
+      success: true,
+      data: { priceCents: 18950, returnDeadline: "2026-11-08", warrantyExpiration: "2027-10-09" },
+    });
+  });
+
+  describe("name", () => {
+    it("requires a name after trimming", () => {
+      expect(errorsFor({ name: "" }).name).toBe("Enter a name.");
+      expect(errorsFor({ name: "   " }).name).toBe("Enter a name.");
+    });
+
+    it("accepts 1 and 100 characters after trimming", () => {
+      expect(validateItemDraft(draft({ name: " a " }), today).success).toBe(true);
+      expect(validateItemDraft(draft({ name: ` ${"a".repeat(100)} ` }), today).success).toBe(true);
+    });
+
+    it("rejects 101 characters after trimming", () => {
+      expect(errorsFor({ name: "a".repeat(101) }).name).toBe(
+        "Use 100 characters or fewer. This one has 101.",
+      );
+    });
+
+    it("counts an emoji as one character", () => {
+      expect(validateItemDraft(draft({ name: "🎁".repeat(100) }), today).success).toBe(true);
+    });
+  });
+
+  describe("purchase date", () => {
+    it("is required", () => {
+      expect(errorsFor({ purchaseDate: "" }).purchaseDate).toBe("Enter the purchase date.");
+    });
+
+    it("rejects dates that do not exist", () => {
+      expect(errorsFor({ purchaseDate: "2026-02-29" }).purchaseDate).toBe(
+        "Enter a complete, real date.",
+      );
+    });
+
+    it("accepts today and a leap day", () => {
+      expect(validateItemDraft(draft({ purchaseDate: today }), today).success).toBe(true);
+      expect(validateItemDraft(draft({ purchaseDate: "2024-02-29" }), today).success).toBe(true);
+    });
+
+    it("rejects tomorrow", () => {
+      expect(errorsFor({ purchaseDate: "2026-10-24" }).purchaseDate).toBe(
+        "Purchase date can’t be in the future.",
+      );
+    });
+  });
+
+  describe("price", () => {
+    it.each([
+      ["-5", "Price can’t be negative."],
+      ["$5", "Use digits only, like 1299.99, without $ or commas."],
+      ["5.999", "Use no more than two decimal places."],
+      ["five", "Enter a price like 49.99, or leave it blank."],
+      ["99999999999999999", "Enter a smaller amount."],
+    ])("rejects %j", (price, message) => {
+      expect(errorsFor({ price }).price).toBe(message);
+    });
+  });
+
+  describe.each([
+    ["returnDeadline", "Return deadline"],
+    ["warrantyExpiration", "Warranty expiration"],
+  ] as const)("%s", (key, label) => {
+    it("accepts the purchase date itself and later dates, including future ones", () => {
+      expect(validateItemDraft(draft({ [key]: "2026-10-09" }), today).success).toBe(true);
+      expect(validateItemDraft(draft({ [key]: "2030-01-01" }), today).success).toBe(true);
+    });
+
+    it("rejects a date before the purchase date", () => {
+      expect(errorsFor({ [key]: "2026-10-08" })[key]).toBe(
+        `${label} can’t be before the purchase date, Oct 9, 2026.`,
+      );
+    });
+
+    it("rejects an invalid date", () => {
+      expect(errorsFor({ [key]: "2026-11-31" })[key]).toBe(
+        "Enter a complete, real date, or clear the field.",
+      );
+    });
+
+    it("skips the comparison when the purchase date is invalid", () => {
+      const errors = errorsFor({ purchaseDate: "", [key]: "2000-01-01" });
+      expect(errors[key]).toBeUndefined();
+    });
+  });
+
+  it("reports every invalid field at once", () => {
+    const errors = errorsFor({
+      name: "",
+      purchaseDate: "2026-10-30",
+      price: "1.234",
+      returnDeadline: "2026-10-01",
+    });
+    expect(Object.keys(errors).sort()).toEqual(["name", "price", "purchaseDate"].sort());
+  });
+
+  it("rejects non-string input from untrusted callers", () => {
+    const result = validateItemDraft({ ...draft(), name: 42 } as unknown as ItemDraft, today);
+    expect(result.success).toBe(false);
+  });
+});
diff --git a/src/features/items/item-schema.ts b/src/features/items/item-schema.ts
new file mode 100644
index 0000000..7b9c791
--- /dev/null
+++ b/src/features/items/item-schema.ts
@@ -0,0 +1,144 @@
+import { z } from "zod";
+import { formatDateOnly, isValidDateOnly } from "@/lib/dates";
+import { type MoneyErrorCode, parseUsdToCents } from "@/lib/money";
+
+export const ITEM_NAME_MAX = 100;
+
+/** Raw text entered in the add/edit item form. */
+export type ItemDraft = {
+  name: string;
+  purchaseDate: string;
+  price: string;
+  returnDeadline: string;
+  warrantyExpiration: string;
+};
+
+export type ItemField = keyof ItemDraft;
+
+/** A validated new item: trimmed name, date-only strings, and integer cents. */
+export type NewItemInput = {
+  name: string;
+  purchaseDate: string;
+  priceCents: number | null;
+  returnDeadline: string | null;
+  warrantyExpiration: string | null;
+};
+
+export type ItemFieldErrors = Partial<Record<ItemField, string>>;
+
+export type ItemValidationResult =
+  | { success: true; data: NewItemInput }
+  | { success: false; fieldErrors: ItemFieldErrors };
+
+export const ITEM_FIELDS: readonly ItemField[] = [
+  "name",
+  "purchaseDate",
+  "price",
+  "returnDeadline",
+  "warrantyExpiration",
+];
+
+const PRICE_ERRORS: Record<MoneyErrorCode, string> = {
+  negative: "Price can’t be negative.",
+  symbols: "Use digits only, like 1299.99, without $ or commas.",
+  decimals: "Use no more than two decimal places.",
+  too_large: "Enter a smaller amount.",
+  format: "Enter a price like 49.99, or leave it blank.",
+};
+
+const DEADLINE_LABELS = {
+  returnDeadline: "Return deadline",
+  warrantyExpiration: "Warranty expiration",
+} as const;
+
+export const INVALID_DATE_MESSAGE = "Enter a complete, real date.";
+export const INVALID_OPTIONAL_DATE_MESSAGE = "Enter a complete, real date, or clear the field.";
+
+function nameError(raw: string): string | undefined {
+  // Count code points so an emoji counts as one character.
+  const length = Array.from(raw.trim()).length;
+  if (length === 0) return "Enter a name.";
+  if (length > ITEM_NAME_MAX) {
+    return `Use ${ITEM_NAME_MAX} characters or fewer. This one has ${length}.`;
+  }
+  return undefined;
+}
+
+function purchaseDateError(value: string, today: string): string | undefined {
+  if (value === "") return "Enter the purchase date.";
+  if (!isValidDateOnly(value)) return INVALID_DATE_MESSAGE;
+  if (value > today) return "Purchase date can’t be in the future.";
+  return undefined;
+}
+
+function deadlineError(
+  field: keyof typeof DEADLINE_LABELS,
+  value: string,
+  validPurchaseDate: string | null,
+): string | undefined {
+  if (value === "") return undefined;
+  if (!isValidDateOnly(value)) return INVALID_OPTIONAL_DATE_MESSAGE;
+  if (validPurchaseDate && value < validPurchaseDate) {
+    return `${DEADLINE_LABELS[field]} can’t be before the purchase date, ${formatDateOnly(validPurchaseDate)}.`;
+  }
+  return undefined;
+}
+
+/**
+ * The shared item draft schema for the form and, later, the item API.
+ * `today` is the user's local calendar date (YYYY-MM-DD), injected by the caller.
+ */
+export function createItemDraftSchema(today: string) {
+  return z
+    .object({
+      name: z.string(),
+      purchaseDate: z.string().trim(),
+      price: z.string(),
+      returnDeadline: z.string().trim(),
+      warrantyExpiration: z.string().trim(),
+    })
+    .superRefine((draft, ctx) => {
+      const purchaseError = purchaseDateError(draft.purchaseDate, today);
+      const validPurchaseDate = purchaseError ? null : draft.purchaseDate;
+      const price = parseUsdToCents(draft.price);
+      const errors: ItemFieldErrors = {
+        name: nameError(draft.name),
+        purchaseDate: purchaseError,
+        price: price.ok ? undefined : PRICE_ERRORS[price.code],
+        returnDeadline: deadlineError("returnDeadline", draft.returnDeadline, validPurchaseDate),
+        warrantyExpiration: deadlineError(
+          "warrantyExpiration",
+          draft.warrantyExpiration,
+          validPurchaseDate,
+        ),
+      };
+      for (const field of ITEM_FIELDS) {
+        const message = errors[field];
+        if (message) ctx.addIssue({ code: "custom", path: [field], message });
+      }
+    })
+    .transform((draft): NewItemInput => {
+      const price = parseUsdToCents(draft.price);
+      return {
+        name: draft.name.trim(),
+        purchaseDate: draft.purchaseDate,
+        priceCents: price.ok ? price.cents : null,
+        returnDeadline: draft.returnDeadline || null,
+        warrantyExpiration: draft.warrantyExpiration || null,
+      };
+    });
+}
+
+export function validateItemDraft(draft: ItemDraft, today: string): ItemValidationResult {
+  const result = createItemDraftSchema(today).safeParse(draft);
+  if (result.success) return { success: true, data: result.data };
+
+  const fieldErrors: ItemFieldErrors = {};
+  for (const issue of result.error.issues) {
+    const field = issue.path[0];
+    if (typeof field === "string" && ITEM_FIELDS.includes(field as ItemField)) {
+      fieldErrors[field as ItemField] ??= issue.message;
+    }
+  }
+  return { success: false, fieldErrors };
+}
