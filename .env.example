# Copy this file to .env.local (ignored by git) and replace the placeholders.
# Never commit real connection strings, passwords, or secrets. See docs/setup.md.

# App database for local development (npm run dev, npm run db:check).
# Preview and production deployments set their own DATABASE_URL in the hosting provider.
DATABASE_URL=postgresql://b4gone:replace-with-password@localhost:5432/b4gone_dev

# Isolated database for npm run test:integration. Integration tests may create and delete data
# here, so the database name must end in _test and must differ from DATABASE_URL.
TEST_DATABASE_URL=postgresql://b4gone:replace-with-password@localhost:5432/b4gone_test

# Signs session cookies (issue #2). Use at least 32 random characters, for example the output of
# `openssl rand -base64 36`. Preview and production deployments each set their own value.
SESSION_SECRET=replace-with-at-least-32-random-characters
